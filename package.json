{
  "name": "gptn",
  "productName": "GPTN",
  "version": "1.0.0",
  "description": "A small, calm desktop client for Google Gemini on macOS. No accounts, no server: your API key lives in the Keychain and your conversations stay on your Mac.",
  "author": "GPTN",
  "license": "MIT",
  "homepage": "https://github.com/andreapieri151-afk/Gptn",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:preview": "vite build --config vite.preview.config.ts && vite preview --config vite.preview.config.ts",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tests",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "start": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:universal": "npm run build && electron-builder --mac --universal --publish never && node scripts/rename-artifacts.mjs",
    "dist:dir": "npm run build && electron-builder --mac --dir --publish never",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
